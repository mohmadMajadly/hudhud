          "type": "string",
          "const": "native"
        },
        "binaryPath": {
          "type": "string",
          "minLength": 1
        },
        "binaryVerification": {
          "enum": [
            "advisory",
            "strict"
          ]
        },
        "claudeCode": {
          "$ref": "#/$defs/ClaudeCodeConnectOptions"
        }
      },
      "additionalProperties": false
    },
    "SessionOptions": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "permissionMode": {
          "$ref": "#/$defs/PermissionMode"
        },
        "dangerouslyAllowBypassPermissions": {
          "type": "boolean"
        },
        "workspaceTrust": {
          "$ref": "#/$defs/WorkspaceTrust"
        },
        "projectCredentialEnv": {
          "enum": [
            "refuse",
            "allow"
          ]
        },
        "env": {
          "$ref": "#/$defs/EnvOption"
        },
        "autoUpdate": {
          "enum": [
            "disabled",
            "harness-default"
          ]
        },
        "nonessentialTraffic": {
          "enum": [
            "disabled",
            "harness-default"
          ]
        },
        "dangerouslyAllowConfigWrites": {
          "type": "boolean"
        },
        "onAuthFailure": {
          "enum": [
            "fail-fast",
            "harness-retry"
          ]
        },
        "onOversizedFrame": {
          "enum": [
            "fail",
            "skip"
          ]
        },
        "maxFrameBytes": {
          "$ref": "#/$defs/FrameBytes"
        },
        "maxOutboundFrameBytes": {
          "$ref": "#/$defs/FrameBytes"
        },
        "firstFrameTimeoutMs": {
          "$ref": "#/$defs/TimeoutMs"
        },
        "idleStallMs": {
          "$ref": "#/$defs/TimeoutMs"
        },
        "closeTimeoutMs": {
          "$ref": "#/$defs/TimeoutMs"
        },
        "termination": {
          "$ref": "#/$defs/Termination"
        },
        "trace": {
          "$ref": "#/$defs/Trace"
        },
        "events": {
          "$ref": "#/$defs/SubscriberOptionsData"
        },
        "claudeCode": {
          "$ref": "#/$defs/ClaudeCodeSessionOptions"
        }
      },
      "additionalProperties": false
    },
    "ResumeOptions": {
      "type": "object",
      "properties": {
        "cwd": {
          "type": "string",
          "minLength": 1
        },
        "permissionMode": {
          "$ref": "#/$defs/PermissionMode"
        },

  "description": "Expected event streams of hudhud's Claude Code conformance suite, as data: byte-identical to what this exact hudhud version asserts.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohmadMajadly/hudhud.git",
    "directory": "packages/conformance"
  },
  "homepage": "https://github.com/mohmadMajadly/hudhud/tree/main/packages/conformance#readme",
  "bugs": {
    "url": "https://github.com/mohmadMajadly/hudhud/issues"
  },
  "type": "module",

                },
                "effort": {
                  "description": "<string>",
                  "enum": {
                    "$set": [
                      "high",
                      "low",
                      "max",
                      "medium",
                      "xhigh"
                    ]
                  },
                  "type": "string"
                },
                "isolation": {
                  "description": "<string>",
                  "enum": {
                    "$set": [
                      "remote",
                      "worktree"
                    ]
                  },
                  "type": "string"
                },
                "model": {
                  "description": "<string>",

{
  "name": "@hudhudjs/core",
  "version": "0.1.0",
  "description": "Sans-IO protocol and session core of hudhud, plus the process layer.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohmadMajadly/hudhud.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/mohmadMajadly/hudhud/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/mohmadMajadly/hudhud/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol/index.d.ts",
      "default": "./dist/protocol/index.js"
    },
    "./process": {
      "types": "./dist/process/index.d.ts",
      "default": "./dist/process/index.js"
    },
    "./binding": {
      "types": "./dist/binding/index.d.ts",
      "default": "./dist/binding/index.js"
    },
    "./schemas/*": "./schemas/*.json",
    "./schemas/*.json": "./schemas/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "NOTICE",
    "schemas",
    "!schemas/.baseline",
    "!**/*.tsbuildinfo"
  ],
  "optionalDependencies": {
    "@hudhudjs/win32-job-x64": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typebox": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

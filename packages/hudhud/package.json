{
  "name": "hudhudjs",
  "version": "0.0.0",
  "description": "Umbrella package for hudhud: re-exports only, exact-version dependencies.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohmadMajadly/hudhud.git",
    "directory": "packages/hudhud"
  },
  "homepage": "https://github.com/mohmadMajadly/hudhud/tree/main/packages/hudhud#readme",
  "bugs": {
    "url": "https://github.com/mohmadMajadly/hudhud/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "NOTICE",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@hudhudjs/claude-code": "workspace:*",
    "@hudhudjs/core": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

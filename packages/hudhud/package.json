{
  "name": "hudhud",
  "version": "0.0.0",
  "private": true,
  "description": "Umbrella package for hudhud: re-exports only, exact-version dependencies.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@hudhud/claude-code": "workspace:*",
    "@hudhud/core": "workspace:*"
  },
  "devDependencies": {
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

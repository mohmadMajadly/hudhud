                    "$set": [
                      "fable",
                      "haiku",
                      "opus",
                      "sonnet"
                    ]
                  },
                  "type": "string"
                },
                "prompt": {
                  "description": "<string>",
                  "type": "string"
                },
                "run_in_background": {
                  "description": "<string>",
                  "type": "boolean"
                },
                "subagent_type": {
                  "description": "<string>",
                  "type": "string"
                }
              },
              "required": {
                "$set": [
                  "description",
                  "prompt"
                ]
              },
              "type": "object"
            },
            "name": "Agent"
          },

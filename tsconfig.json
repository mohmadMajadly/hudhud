{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "tsBuildInfoFile": "node_modules/.cache/tsc/tooling.tsbuildinfo",
    "types": ["node"]
  },
  "include": [
    "*.ts",
    "*.js",
    "*.mjs",
    ".dependency-cruiser.mjs",
    "scripts/**/*.mjs",
    "scripts/**/*.ts",
    "packages/*/test/**/*.ts",
    "packages/*/schema-src/**/*.ts",
    "tooling/*/test/**/*.ts",
    "tooling/*/bin/**/*.mjs"
  ],
  "references": [
    { "path": "packages/core" },
    { "path": "packages/claude-code" },
    { "path": "packages/hudhud" },
    { "path": "tooling/test-support" }
  ]
}

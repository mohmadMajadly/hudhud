{
  "config": {
    "default": true,
    // Prose is not hard-wrapped; editors soft-wrap and diffs stay sentence-sized.
    "MD013": false,
  },
  "globs": ["**/*.md"],
  // Skips node_modules, build output, coverage and API Extractor scratch files.
  "gitignore": true,
  "ignores": [
    // Generated by API Extractor and Changesets.
    "packages/*/api/**",
    "**/CHANGELOG.md",
    // Owner-maintained design documents: not lint-clean yet (see
    // CONTRIBUTING.md); covered by the link checker and the privacy scan.
    "docs/**",
  ],
}

{
  "name": "@hudhudjs/claude-code",
  "version": "0.1.0",
  "description": "Claude Code adapter for hudhud.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mohmadMajadly/hudhud.git",
    "directory": "packages/claude-code"
  },
  "homepage": "https://github.com/mohmadMajadly/hudhud/tree/main/packages/claude-code#readme",
  "bugs": {
    "url": "https://github.com/mohmadMajadly/hudhud/issues"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./raw": {
      "types": "./dist/raw/index.d.ts",
      "default": "./dist/raw/index.js"
    },
    "./schemas/*": "./schemas/*.json",
    "./schemas/*.json": "./schemas/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "NOTICE",
    "schemas",
    "!schemas/.baseline",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "@hudhudjs/core": "workspace:*"
  },
  "devDependencies": {
    "@hudhudjs/test-support": "workspace:*",
    "@types/node": "catalog:",
    "fast-check": "catalog:",
    "typebox": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

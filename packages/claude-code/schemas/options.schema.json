          ]
        },
        "env": {
          "$ref": "#/$defs/EnvOption"
        },
        "autoUpdate": {
          "enum": [
            "disabled",
            "harness-default"
          ]
        },
        "nonessentialTraffic": {
          "enum": [
            "disabled",
            "harness-default"
          ]
        },
        "dangerouslyAllowConfigWrites": {
          "type": "boolean"
        },
        "onAuthFailure": {
          "enum": [
            "fail-fast",
            "harness-retry"
          ]
        },
        "onOversizedFrame": {
          "enum": [
            "fail",
            "skip"
          ]
        },
        "maxFrameBytes": {
          "$ref": "#/$defs/FrameBytes"
        },
        "maxOutboundFrameBytes": {
          "$ref": "#/$defs/FrameBytes"
        },
        "firstFrameTimeoutMs": {
          "$ref": "#/$defs/TimeoutMs"
        },
        "idleStallMs": {
          "$ref": "#/$defs/TimeoutMs"
        },
        "closeTimeoutMs": {
          "$ref": "#/$defs/TimeoutMs"
        },
        "termination": {
          "$ref": "#/$defs/Termination"
        },
        "trace": {
          "$ref": "#/$defs/Trace"
        },
        "events": {
          "$ref": "#/$defs/SubscriberOptionsData"
        },
        "claudeCode": {
          "$ref": "#/$defs/ClaudeCodeSessionOptions"
        },
        "fork": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "ConnectSessionOptions": {
      "type": "object",
      "properties": {
        "backend": {
          "type": "string",
          "const": "native"
        },
        "binaryPath": {
          "type": "string",
